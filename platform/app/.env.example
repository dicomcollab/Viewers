##
# Viewer (OHIF) environment — URLs only. Never put credentials or API keys here.
# Served values are substituted at build time into public app-config.js.
#

PUBLIC_URL=/
APP_CONFIG=config/default.js
USE_HASH_ROUTER=false

# Med-PACS DICOMweb (no trailing slash on host roots except /api)
MED_PACS_DICOMWEB_API_ROOT=https://med-pacs-dev-dicomcloudwebapi-linux-cyhzgxbbb5hqcgby.eastus-01.azurewebsites.net/api
MED_PACS_DICOMWEB_WADOURI_ROOT=https://med-pacs-dev-dicomcloudwebapi-linux-cyhzgxbbb5hqcgby.eastus-01.azurewebsites.net/wadouri
AZURE_DICOM_SERVICE_URL=https://med-pacs-dev-dicomcloudwebapi-linux-cyhzgxbbb5hqcgby.eastus-01.azurewebsites.net

# RIS / Synapse integration
RIS_PROD_PORTAL_ORIGIN=https://synapse.med-pacs.com
RIS_PROD_API_BASE=https://med-pacs-dev-risapi-fgb0frguhuaqgrfs.eastus-01.azurewebsites.net
RIS_DEV_PORTAL_ORIGIN=http://localhost:5173
RIS_DEV_API_BASE=http://localhost:5001

REACT_APP_RIS_WORKLIST_URL=
REACT_APP_RIS_LOGIN_URL=
REACT_APP_RIS_API_BASE=
REACT_APP_BACKEND_HOTKEY_URL=
