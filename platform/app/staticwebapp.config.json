{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/*.{css,js,png,gif,ico,jpg,svg,woff,woff2,json,map,wasm}"]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  },
  "routes": [
    {
      "route": "/sw.js",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/app-config.js",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/init-service-worker.js",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/index.html",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/*.bundle.*.js",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/*.{png,gif,ico,jpg,svg,woff,woff2,wasm}",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    }
  ],
  "globalHeaders": {
    "X-Frame-Options": "DENY",
    "Content-Security-Policy": "frame-ancestors %%CSP_FRAME_ANCESTORS%%",
    "Cache-Control": "no-cache"
  }
}
