{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/*.{css,js,png,gif,ico,jpg,svg,woff,woff2,json,map,wasm}"]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  },
  "globalHeaders": {
    "X-Frame-Options": "DENY",
    "Content-Security-Policy": "frame-ancestors %%CSP_FRAME_ANCESTORS%%"
  }
}
